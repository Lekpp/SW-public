<ui:MedievalWindow
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Content.Client.Imperial.Medieval.UserInterface.Windows.MedievalCampfireMenu"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:ui="clr-namespace:Content.Client.Imperial.Medieval.CapturePoint.UI.MedievalWindow"
    xmlns:style="clr-namespace:Content.Client.Imperial.Medieval.UserInterface.Elements"
    Title="{Loc 'medieval-campfire-menu-title'}"
    Resizable="False">
    <!-- fixed width: labels changing length must not resize the window -->
    <BoxContainer Orientation="Vertical" SetWidth="336">
        <!-- the fire in the middle, the food laid out around it, the firewood underneath -->
        <PanelContainer HorizontalAlignment="Center">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat
                    BackgroundColor="{x:Static style:MedievalUiStyle.Inset}"
                    BorderColor="{x:Static style:MedievalUiStyle.Border}"
                    BorderThickness="2" />
            </PanelContainer.PanelOverride>
            <LayoutContainer Name="PotLayout" />
        </PanelContainer>

        <!-- what the firewood adds up to; while cooking, the countdown. No progress bar: the logs burn down instead -->
        <Label Name="TimeLabel" Align="Center" Margin="0 4 0 0" />

        <Label Name="StatusLabel" Align="Center" FontColorOverride="{x:Static style:MedievalUiStyle.TextFaded}" Margin="0 2 0 8" />

        <BoxContainer Orientation="Horizontal">
            <ui:MedievalButton
                Name="StartButton"
                Access="Public"
                Text="{Loc 'medieval-campfire-menu-start'}"
                HorizontalExpand="True"
                TextAlign="Center" />
            <ui:MedievalButton
                Name="EjectButton"
                Access="Public"
                Text="{Loc 'medieval-campfire-menu-eject'}"
                ToolTip="{Loc 'medieval-campfire-menu-eject-tooltip'}"
                HorizontalExpand="True"
                TextAlign="Center" />
        </BoxContainer>

        <controls:HLine Color="{x:Static style:MedievalUiStyle.Border}" Thickness="1" Margin="0 8 0 2" />
        <Label
            Text="{Loc 'medieval-campfire-menu-footer'}"
            FontColorOverride="{x:Static style:MedievalUiStyle.TextFaded}"
            StyleClasses="WindowFooterText" />
    </BoxContainer>
</ui:MedievalWindow>
