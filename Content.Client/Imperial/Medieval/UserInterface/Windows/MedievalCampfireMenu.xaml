<ui:MedievalWindow
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Content.Client.Imperial.Medieval.UserInterface.Windows.MedievalCampfireMenu"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:ui="clr-namespace:Content.Client.Imperial.Medieval.CapturePoint.UI.MedievalWindow"
    Title="{Loc 'medieval-campfire-menu-title'}"
    Resizable="False">
    <!-- fixed width: labels changing length must not resize the window -->
    <BoxContainer Orientation="Vertical" SetWidth="336">
        <!-- The fire in the middle, the food laid out around it -->
        <PanelContainer HorizontalAlignment="Center">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#150f0c" BorderColor="#5c4a3d" BorderThickness="2" />
            </PanelContainer.PanelOverride>
            <LayoutContainer Name="PotLayout" />
        </PanelContainer>

        <!-- firewood lives in the pot layout, under the fire; this is what it adds up to.
             No progress bar: while cooking the logs themselves burn down one by one -->
        <Label Name="TimeLabel" Align="Center" Margin="0 4 0 0" />

        <Label Name="StatusLabel" Align="Center" FontColorOverride="#7a6a58" Margin="0 2 0 8" />

        <BoxContainer Orientation="Horizontal">
            <ui:MedievalButton
                Name="StartButton"
                Access="Public"
                Text="{Loc 'medieval-campfire-menu-start'}"
                HorizontalExpand="True"
                TextAlign="Center" />
            <ui:MedievalButton
                Name="EjectButton"
                Access="Public"
                Text="{Loc 'medieval-campfire-menu-eject'}"
                ToolTip="{Loc 'medieval-campfire-menu-eject-tooltip'}"
                HorizontalExpand="True"
                TextAlign="Center" />
        </BoxContainer>

        <controls:HLine Color="#5c4a3d" Thickness="1" Margin="0 8 0 2" />
        <Label Text="{Loc 'medieval-campfire-menu-footer'}" FontColorOverride="#7a6a58" StyleClasses="WindowFooterText" />
    </BoxContainer>
</ui:MedievalWindow>
